rules_version = '2';

// Daftar email assessor/admin yang boleh mengelola data.
function isAssessor() {
  return request.auth != null &&
    request.auth.token.email in ['emteef.business@gmail.com', 'assessment.homui@gmail.com'];
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /sessions/{kodeAkses} {
      // Peserta tidak login; aksesnya dikontrol oleh kerahasiaan kode akses.
      allow get: if true;
      allow list: if isAssessor();
      allow create: if isAssessor();
      allow delete: if isAssessor();

      // Peserta hanya boleh mengubah field dirinya, bukan review/audit, dan tidak boleh 'final'.
      allow update: if isAssessor() ||
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['participant', 'segments', 'aiCoding', 'status']) &&
         resource.data.status != 'final' &&
         request.resource.data.status != 'final');
    }
  }
}